# Browser-exposed NAVER Dynamic Map Client ID.
VITE_NAVER_MAP_CLIENT_ID=Client_ID

# Server-only NAVER place-search credentials.
# Do NOT prefix these with VITE_. The Vite dev server proxy reads them only in Node.
# Current NAVER API HUB credentials:
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=


# Server-only NAVER Maps credentials for Directions 5.
# Client ID may be the same Maps Application ID as VITE_NAVER_MAP_CLIENT_ID.
# Client Secret must never use a VITE_ prefix.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
