@'
# Dependencies
node_modules/

# Build output
dist/
.vite/
*.tsbuildinfo

# Local environment
.env
.env.local
.env.*.local

# TripPlanner runtime data
.tripplanner/
.tripplanner-test-attachments/

# Local configuration overrides
config/provider-cache-policy.override.json

# Database
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
*.db-shm
*.db-wal

# Logs / OS
*.log
.DS_Store
Thumbs.db
'@ | Set-Content ".gitignore" -Encoding UTF8