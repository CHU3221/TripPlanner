# Browser-visible map SDK credentials, but delivered by the backend only after login.
# They are still NOT secrets once an authorized browser receives them: keep provider
# HTTP-referrer/API restrictions and quotas enabled.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=
VITE_NAVER_MAP_CLIENT_ID=

# Admin credentials are intentionally omitted for first boot.
# If BOTH ADMIN_ID and ADMIN_PASSWORD_HASH are absent, login is admin/admin and the UI
# immediately forces a new admin ID/password, writing a scrypt hash to .env.local.
# To recover access through SSH, stop the server, remove BOTH fields, then restart.
# ADMIN_ID=
# ADMIN_PASSWORD_HASH=

# NAVER server-side API credentials. Never add VITE_ to secrets.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Backend persistence (server process; do not prefix with VITE_)
TRIPPLANNER_SERVER_HOST=127.0.0.1
TRIPPLANNER_SERVER_PORT=8787
TRIPPLANNER_DB_PATH=.tripplanner/tripplanner.sqlite
